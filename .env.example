# .env.example - contains no real credentials.
# Copy this file to .env (which is gitignored) and put your own key in .env.
# Without a key StudyBuddy still runs: AI features are disabled and search uses keyword ranking.
GEMINI_API_KEY=YOUR_LOCAL_API_KEY_HERE

# Optional overrides of settings in src/main/resources/studybuddy.properties.
# The variable name is STUDYBUDDY_ + the property key in upper case with dots as underscores.
# STUDYBUDDY_DB_PATH=data/studybuddy.db
# STUDYBUDDY_LLM_MODEL_ROUTINE=gemini-3.1-flash-lite
